# 이 파일을 .env로 복사해 값을 채웁니다. .env는 저장소에 올라가지 않습니다.
#
# 두 값 모두 **서버에서만** 쓰입니다. 브라우저로 내려보내지 않습니다 —
# 이 앱은 클라이언트가 Supabase에 직접 접근하는 경로를 두지 않았습니다.

SUPABASE_URL=https://<프로젝트>.supabase.co

# ⚠ service_role 키는 RLS를 통째로 우회합니다. 절대 브라우저·저장소·채팅에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 선택 — WebAuthn이 허용할 주소를 직접 지정하고 싶을 때(쉼표로 구분).
# 비워 두면 localhost와 Vercel이 알려주는 배포 주소가 자동으로 허용됩니다.
# RP_ORIGINS=https://aleph-passkey.vercel.app
