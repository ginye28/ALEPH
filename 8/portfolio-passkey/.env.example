# 이 파일을 .env로 복사해 값을 채웁니다. .env는 저장소에 올라가지 않습니다.
#
# 배포(Vercel)에서는 Neon 연동이 DATABASE_URL을 자동으로 넣어 주므로 따로 적을 필요가
# 없습니다. 이 파일은 로컬에서 `npm run db:init`으로 스키마를 적용할 때만 씁니다.
#
# ⚠ 이 접속 문자열 하나로 모든 자료를 읽고 쓸 수 있습니다.
#    저장소·채팅·화면 어디에도 붙여넣지 마세요. 서버에만 둡니다.
DATABASE_URL=

# 선택 — WebAuthn이 허용할 주소를 직접 지정하고 싶을 때(쉼표로 구분).
# 비워 두면 localhost와 Vercel이 알려주는 배포 주소가 자동으로 허용됩니다.
# RP_ORIGINS=https://aleph-passkey.vercel.app
